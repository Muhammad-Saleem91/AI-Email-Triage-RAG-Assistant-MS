      "name": "Normalize Email"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nlet body = item.body || '';\n\n// Remove URLs written as [https://...]\nbody = body.replace(/\\[https?:\\/\\/[^\\]]+\\]/g, ' ');\n\n// Remove normal URLs\nbody = body.replace(/https?:\\/\\/\\S+/g, ' ');\n\n// Remove quoted email lines\nbody = body.replace(/^\\s*>.*$/gm, '');\n\n// Remove previous quoted reply when possible\nconst replyIndex = body.search(/\\nOn .+wrote:\\s*/i);\n\nif (replyIndex !== -1) {\n  body = body.slice(0, replyIndex);\n}\n\n// Clean whitespace\nbody = body\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn [\n  {\n    json: {\n      ...item,\n      body\n    }\n  }\n];"
      },
